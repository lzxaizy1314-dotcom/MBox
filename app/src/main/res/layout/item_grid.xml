<?xml version="1.0" encoding="utf-8"?>
<!-- Muse 风白卡片:16:9 横图在上,标题副标题在下;ID 与旧版一致,GridAdapter 无需改动 -->
<com.lihang.ShadowLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:hl_cornerRadius="@dimen/radius_card"
    app:hl_layoutBackground="@color/bg_card"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 16:9 图片区:上方圆角,下方直角,与文字区齐平 -->
        <com.github.tvbox.osc.ui.kit.RatioShadowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hl_cornerRadius_topLeft="@dimen/radius_card"
            app:hl_cornerRadius_topRight="@dimen/radius_card"
            app:hl_layoutBackground="@android:color/transparent">

            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/placeholder_poster"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="70dp"
                android:ellipsize="end"
                android:paddingHorizontal="7dp"
                android:paddingVertical="4dp"
                android:layout_margin="8dp"
                android:singleLine="true"
                android:background="@drawable/bg_badge_year"
                tools:text="2023"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </com.github.tvbox.osc.ui.kit.RatioShadowLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_foreground"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="狂飙" />

        <TextView
            android:id="@+id/tvNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_sub"
            android:textSize="11sp"
            tools:text="2023 · 国产剧 · 9.1" />

    </LinearLayout>

</com.lihang.ShadowLayout>
